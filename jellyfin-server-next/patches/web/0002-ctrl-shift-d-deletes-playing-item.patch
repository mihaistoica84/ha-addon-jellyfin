+/**
+ * Ctrl+Shift+D deletes the currently playing item, after the usual delete confirmation
+ * (with Delete focused, so Enter confirms and Escape cancels).
+ * @module scripts/deletePlayingItemShortcut
+ */
+
+import { ServerConnections } from 'lib/jellyfin-apiclient';
+import globalize from 'lib/globalize';
+
+let isDeleting = false;
+
+export function isDeleteShortcut(e) {
+    return e.ctrlKey && e.shiftKey && !e.altKey && !e.metaKey && e.code === 'KeyD';
+}
+
+async function deletePlayingItem() {
+    const { playbackManager } = await import('components/playback/playbackmanager');
+    const player = playbackManager.getCurrentPlayer();
+    const playingItem = player && playbackManager.currentItem(player);
+    if (!playingItem?.Id) {
+        return;
+    }
+
+    const apiClient = ServerConnections.getApiClient(playingItem.ServerId);
+    const item = await apiClient.getItem(apiClient.getCurrentUserId(), playingItem.Id);
+    if (!item.CanDelete) {
+        const { default: toast } = await import('components/toast/toast');
+        toast(globalize.translate('MessageDeletePlayingItemNotAllowed'));
+        return;
+    }
+
+    const { deleteItem } = await import('./deleteHelper');
+    const deletion = deleteItem({ item, navigate: false });
+    focusConfirmButton();
+    await deletion;
+}
+
+/**
+ * Focuses the confirm dialog's Delete button once the dialog has finished opening
+ * (dialogs focus Cancel when their open animation ends), so Enter confirms and Escape cancels.
+ */
+function focusConfirmButton() {
+    const startTime = Date.now();
+
+    const tryFocus = () => {
+        const button = document.querySelector('.dialog.opened .btnOption[data-id="ok"]');
+        if (!button) {
+            if (Date.now() - startTime < 5000) {
+                setTimeout(tryFocus, 50);
+            }
+            return;
+        }
+
+        const dlg = button.closest('.dialog');
+        const focusButton = () => setTimeout(() => button.focus());
+        if (dlg.getAnimations().some(animation => animation.playState === 'running')) {
+            dlg.addEventListener('animationend', focusButton, { once: true });
+        } else {
+            focusButton();
+        }
+    };
+
+    tryFocus();
+}
+
+export function enable() {
+    window.addEventListener('keydown', (e) => {
+        if (!isDeleteShortcut(e) || e.repeat) {
+            return;
+        }
+
+        // Override the browser's own Ctrl+Shift+D (bookmark all tabs)
+        e.preventDefault();
+        e.stopPropagation();
+
+        if (isDeleting) {
+            return;
+        }
+
+        isDeleting = true;
+        deletePlayingItem()
+            .catch(() => {
+                // Deletion cancelled or failed; deleteHelper already shows any error
+            })
+            .finally(() => {
+                isDeleting = false;
+            });
+    }, true);
+}
+
+export default {
+    enable,
+    isDeleteShortcut
+};
