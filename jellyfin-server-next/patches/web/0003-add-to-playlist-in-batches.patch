From 0473f5d62e3e1a6b73effd719c61df3e87636644 Mon Sep 17 00:00:00 2001
From: mihaistoica84 <5723936+mihaistoica84@users.noreply.github.com>
Date: Tue, 24 Nov 2026 12:05:39 +0000
Subject: [PATCH] Add items to playlist in batches to avoid HTTP 414 for long
 play queues

Saving the now playing queue to an existing playlist sent every item id in
the query string; queues of roughly 240+ items exceeded the server's request
line limit and failed with "Error adding to playlist".

---
 .../playlisteditor/playlisteditor.ts          | 24 ++++++++++++++-----
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/src/components/playlisteditor/playlisteditor.ts b/src/components/playlisteditor/playlisteditor.ts
index 5ad8ec65fb..a3c8fe1b1d 100644
--- a/src/components/playlisteditor/playlisteditor.ts
+++ b/src/components/playlisteditor/playlisteditor.ts
@@ -45,6 +45,8 @@ interface PlaylistEditorOptions {
 
 let currentServerId: string;
 
+const ADD_TO_PLAYLIST_BATCH_SIZE = 100;
+
 function onSubmit(this: HTMLElement, e: Event) {
     const panel = dom.parentWithClass(this, 'dialog') as DialogElement | null;
 
@@ -165,12 +167,22 @@ function addToPlaylist(dlg: DialogElement, id: string) {
 
     if (!api) return Promise.reject(new Error('No Api instance available'));
 
-    return getPlaylistApi(api)
-        .addItemToPlaylist({
-            playlistId: id,
-            ids: itemIds.split(','),
-            userId: apiClient?.getCurrentUserId()
-        })
+    // Item ids are sent in the query string, so large selections (e.g. a long play queue)
+    // exceed the server's request line limit (HTTP 414). Add them in ordered batches instead.
+    const ids = itemIds.split(',').filter(Boolean);
+    let request = Promise.resolve();
+    for (let i = 0; i < ids.length; i += ADD_TO_PLAYLIST_BATCH_SIZE) {
+        const batch = ids.slice(i, i + ADD_TO_PLAYLIST_BATCH_SIZE);
+        request = request.then(() => getPlaylistApi(api)
+            .addItemToPlaylist({
+                playlistId: id,
+                ids: batch,
+                userId: apiClient?.getCurrentUserId()
+            })
+            .then(() => undefined));
+    }
+
+    return request
         .then(() => {
             dlg.submitted = true;
             dialogHelper.close(dlg);
-- 
