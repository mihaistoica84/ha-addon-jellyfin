diff --git a/src/elements/emby-itemscontainer/followPlayingItem.ts b/src/elements/emby-itemscontainer/followPlayingItem.ts
new file mode 100644
index 0000000000..ee19f30ea5
--- /dev/null
+++ b/src/elements/emby-itemscontainer/followPlayingItem.ts
@@ -0,0 +1,127 @@
+import focusManager from 'components/focusManager';
+import { playbackManager } from 'components/playback/playbackmanager';
+import Events from 'utils/events';
+
+const ROW_SELECTOR = '.listItem[data-id]';
+const PLAYING_CLASS = 'listItem-nowPlaying';
+
+function findRow(container: HTMLElement, attribute: string, value: string): HTMLElement | null {
+    const rows = container.querySelectorAll<HTMLElement>(ROW_SELECTOR);
+    for (const row of rows) {
+        if (row.getAttribute(attribute) === value) return row;
+    }
+    return null;
+}
+
+function getPlayingRow(container: HTMLElement): HTMLElement | null {
+    const player = playbackManager.getCurrentPlayer();
+    if (!player) return null;
+
+    const item = playbackManager.currentItem(player);
+    if (!item?.Id) return null;
+
+    // Prefer the exact queue entry, so a track queued twice highlights the right row
+    const playlistItemId = playbackManager.getCurrentPlaylistItemId(player);
+    return (playlistItemId && findRow(container, 'data-playlistitemid', playlistItemId))
+        || findRow(container, 'data-id', item.Id);
+}
+
+function getVisibleBounds() {
+    let top = 0;
+    let bottom = window.innerHeight;
+
+    document.querySelectorAll<HTMLElement>('.skinHeader, .MuiAppBar-root').forEach(header => {
+        const rect = header.getBoundingClientRect();
+        if (rect.height && rect.top <= 0) top = Math.max(top, rect.bottom);
+    });
+
+    const nowPlayingBar = document.querySelector<HTMLElement>('.nowPlayingBar:not(.hide)');
+    if (nowPlayingBar) {
+        const rect = nowPlayingBar.getBoundingClientRect();
+        if (rect.height) bottom = Math.min(bottom, rect.top);
+    }
+
+    return { top, bottom };
+}
+
+function isFullyVisible(row: HTMLElement) {
+    const rect = row.getBoundingClientRect();
+    const bounds = getVisibleBounds();
+    return rect.top >= bounds.top && rect.bottom <= bounds.bottom;
+}
+
+function canMoveFocus(container: HTMLElement) {
+    const active = document.activeElement;
+    return !active || active === document.body || container.contains(active);
+}
+
+/**
+ * Keeps the row of the currently playing item highlighted, scrolled into view and focused.
+ * Returns a function that stops following.
+ */
+export function followPlayingItem(container: HTMLElement): () => void {
+    let followedRow: HTMLElement | null = null;
+    let frame = 0;
+
+    const update = () => {
+        frame = 0;
+        const row = getPlayingRow(container);
+
+        container.querySelectorAll<HTMLElement>(`.${PLAYING_CLASS}`).forEach(el => {
+            if (el !== row) el.classList.remove(PLAYING_CLASS);
+        });
+
+        if (!row) {
+            followedRow = null;
+            return;
+        }
+
+        row.classList.add(PLAYING_CLASS);
+
+        // Hidden (cached) pages are handled when they are shown again
+        if (row === followedRow || !row.offsetParent) return;
+        followedRow = row;
+
+        if (canMoveFocus(container) && focusManager.isCurrentlyFocusable(row)) {
+            row.focus({ preventScroll: true });
+        }
+
+        if (!isFullyVisible(row)) {
+            row.scrollIntoView({ block: 'center', behavior: 'smooth' });
+        }
+    };
+
+    const scheduleUpdate = () => {
+        if (!frame) frame = requestAnimationFrame(update);
+    };
+
+    const onPlaybackStart = () => {
+        followedRow = null;
+        scheduleUpdate();
+    };
+
+    const onViewShow = (e: Event) => {
+        if (e.target instanceof Node && e.target.contains(container)) {
+            followedRow = null;
+            scheduleUpdate();
+        }
+    };
+
+    const observer = new MutationObserver(scheduleUpdate);
+    observer.observe(container, { childList: true, subtree: true });
+
+    Events.on(playbackManager, 'playbackstart', onPlaybackStart);
+    Events.on(playbackManager, 'playbackstop', scheduleUpdate);
+    // viewshow does not bubble, so listen in the capture phase
+    document.addEventListener('viewshow', onViewShow, true);
+
+    scheduleUpdate();
+
+    return () => {
+        if (frame) cancelAnimationFrame(frame);
+        observer.disconnect();
+        Events.off(playbackManager, 'playbackstart', onPlaybackStart);
+        Events.off(playbackManager, 'playbackstop', scheduleUpdate);
+        document.removeEventListener('viewshow', onViewShow, true);
+    };
+}
